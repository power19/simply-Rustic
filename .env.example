DATABASE_URL="file:./dev.db"

PORT=3000
SESSION_SECRET="change-this-to-a-long-random-string"

# Seeded on first run of `npm run seed` if no admin user exists yet
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-this-password"

# Used only until you add notification numbers in the dashboard's
# Settings page (Order notifications), which takes over after that.
# WhatsApp number (with country code, no + or spaces, e.g. 15551234567)
# that new orders and service inquiries get forwarded to.
ADMIN_WHATSAPP_NUMBER=""

# Used only until you set these in the dashboard's Settings page, which
# takes over after that (stored in the database, editable without a restart).
BUSINESS_NAME="Simply Rustic Catering"
CURRENCY_SYMBOL="R"

# Optional: path to an already-installed Chrome/Chromium binary (e.g. /usr/bin/google-chrome-stable).
# Leave blank to use the Chromium that whatsapp-web.js/puppeteer downloads itself.
CHROME_EXECUTABLE_PATH=""
